# Neon Postgres. In Vercel, install the Neon Marketplace integration so this is injected.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Auth.js. Generate locally with: npx auth secret
AUTH_SECRET="replace-with-random-secret"
AUTH_URL="http://localhost:3100"

# Discord Developer Portal OAuth client.
# Local callback URL: http://localhost:3100/api/auth/callback/discord
# Production callback URL: https://<vercel-domain>/api/auth/callback/discord
AUTH_DISCORD_ID="replace-with-discord-client-id"
AUTH_DISCORD_SECRET="replace-with-discord-client-secret"

# Vercel Cron authorization for /api/cron/discord-deadlines.
CRON_SECRET="replace-with-random-cron-secret"
