# Neon Postgres. In Vercel, install the Neon Marketplace integration so this is injected.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Auth.js. Generate locally with: npx auth secret
AUTH_SECRET="replace-with-random-secret"
AUTH_URL="http://localhost:3000"

# Google Cloud Console OAuth client.
# Local callback URL: http://localhost:3000/api/auth/callback/google
# Production callback URL: https://<vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"
